  "components": {
    "schemas": {
      "CreateCategoryDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "type": "string"
          }
        }
      },
      "CreateOrderDto": {
        "required": [
          "customerName",
          "email",
          "phone",
          "address",
          "items"
        ],
        "type": "object",
        "properties": {
          "customerName": {
            "maxLength": 100,
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "maxLength": 50,
            "type": "string"
          },
          "address": {
            "maxLength": 300,
            "type": "string"
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderItemDto"
            }
          }
        }
      },
      "CreateOrderItemDto": {
        "required": [
          "productId"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "quantity": {
            "maximum": 100,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateProductDto": {
        "required": [
          "name",
          "description",
          "image",
          "categoryId"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "maximum": 999999999,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "image": {
            "type": "string"
          },
          "rating": {
            "maximum": 5,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "categoryId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
